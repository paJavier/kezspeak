# Copy to .env.local and fill in. .env.local is gitignored; this file holds no real values.

# --- Frontend (Vite). VITE_* values are bundled into the browser, so only public keys go here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# The anon key is meant to be public; row-level security protects the data.
VITE_SUPABASE_ANON_KEY=
VITE_ML_API_URL=http://localhost:8000

# --- Server-side only (no VITE_ prefix, never reaches the browser).
# Read by ml-service and by `supabase functions serve --env-file .env.local`.
SUPABASE_SERVICE_ROLE_KEY=
# python -c "import secrets; print(secrets.token_hex(32))"
KEZSPEAK_API_KEY=
KEZSPEAK_ML_URL=

# --- Optional ml-service settings (defaults shown)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8443
# WHISPER_MODEL=small
# ENABLE_GRAMMAR=true
# MODEL_PATH=model/kezspeak_production_xgboost.pkl

# Google Gemini key for the AI fallback feedback (Edge Function secret; server-side only)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest  (ml-service tries each in order)
